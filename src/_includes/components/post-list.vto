<ul class="posts">
{{ for post of posts }}
  <li
    ><a href="{{ post.url }}">{{ post.data.title }}</a> <small><time datetime="{{ post.date |> isoDate }}">{{ post.date |> readableDate }}</time></small>{{ if post.data.updated }} <small>Updated <time datetime="{{ post.data.updated |> isoDate }}">{{ post.data.updated |> readableDate }}</time></small>{{ /if }}{{ if post.data.draft }} <small class="draft-badge">Draft</small>{{ /if }}
    <div>{{ post.data.description }}</div></li>
{{ /for }}
</ul>
